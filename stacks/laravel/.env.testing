# .env.testing — the test suite environment (.ai/rules/tests.md §Tests): it replaces .env, it is not merged with it,
# and an environment variable with the same name wins over it (DB_HOST in Docker Compose, for instance).
#
# Seeded by the ai-protocol kit: once installed, it belongs to the project. No secrets: the test database is local
# and disposable, and APP_KEY only serves the tests; generate it once with
# «php artisan key:generate --env=testing» and commit it.
APP_NAME=Laravel
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# PostgreSQL with PostGIS, like production; a database other than the development one.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=testing
DB_USERNAME=postgres
DB_PASSWORD=postgres

BCRYPT_ROUNDS=4
CACHE_STORE=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
