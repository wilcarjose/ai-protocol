# .env.testing — el entorno de la suite (.ai/rules/tests.md §Tests): sustituye a .env, no se mezcla, y una variable
# de entorno con el mismo nombre le gana (DB_HOST en Docker Compose, por ejemplo).
#
# Es una semilla del kit ai-protocol: después de instalarla es del proyecto. No lleva secretos: la base de datos de
# tests es local y desechable, y APP_KEY sólo sirve a los tests; se genera una vez con
# «php artisan key:generate --env=testing» y se versiona.
APP_NAME=Laravel
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# PostgreSQL con PostGIS, como producción; una base de datos distinta de la de desarrollo.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=testing
DB_USERNAME=postgres
DB_PASSWORD=postgres

BCRYPT_ROUNDS=4
CACHE_STORE=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
